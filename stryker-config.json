{
  "stryker-config": {
    "solution": "HealthPublishers.slnx",
    "mutation-level": "Advanced",
    "reporters": ["html", "json", "dashboard", "progress"],
    "project-info": { "name": "github.com/dailydevops/healthpublishers" },
    "thresholds": { "high": 80, "low": 60, "break": 0 },
    "test-projects": [
      "tests/NetEvolve.HealthPublishers.Tests.Architecture/NetEvolve.HealthPublishers.Tests.Architecture.csproj",
      "tests/NetEvolve.HealthPublishers.Tests.Unit/NetEvolve.HealthPublishers.Tests.Unit.csproj"
    ],
    "coverage-analysis": "all",
    "mutate": ["**/*.cs", "!**/*.Designer.cs", "!**/*.g.cs", "!**/*.g.i.cs"],
    "configuration": "Mutation",
    "test-runner": "mtp"
  }
}
